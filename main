    COMMAND_INTERVAL = 2,
    
    -- เปิด/ปิด Debug Mode
    DEBUG = true,
}

-- คำนวณจำนวนสูงสุดต่อ 1 รอบ (9999 * 20 = 199,980 ชิ้น/รอบ)
CONFIG.MAX_PER_ROUND = CONFIG.MAX_ITEM_PER_SEND * CONFIG.MAX_SPLIT

-- 📥 รองรับการ Config จากภายนอก
if _G.MAIL_CONFIG then
    for k, v in pairs(_G.MAIL_CONFIG) do
        CONFIG[k] = v
    end
