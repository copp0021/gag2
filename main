-- ====================================================
-- 📌 ฟังก์ชันรอโหลดเกม
-- ====================================================
local function WaitForGameLoaded()
    if not game:IsLoaded() then
        game.Loaded:Wait()
    end
    return true
end

-- ====================================================
-- ระบบหลัก
-- ====================================================
WaitForGameLoaded()

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

-- เลือก HTTP Request function ที่มี
local httpRequest
if syn and syn.request then
    httpRequest = syn.request
elseif http and http.request then
    httpRequest = http.request
elseif request then
    httpRequest = request
else
    httpRequest = function(...)
        warn("❌ ไม่พบ HTTP Request function")
        return nil
    end
end

local WEB_URL = CONFIG.WEB_URL
local KEYS = CONFIG.KEYS
local MAX_ITEM_PER_SEND = CONFIG.MAX_ITEM_PER_SEND
local MAX_SPLIT = CONFIG.MAX_SPLIT
local MAX_PER_ROUND = MAX_ITEM_PER_SEND * MAX_SPLIT

function Log(...)
    if CONFIG.DEBUG then
        print(...)
    end
end

Log("⏳ กำลังรอโหลดเกมและข้อมูลตัวละครให้เสร็จสมบูรณ์...")

-- รอให้ Character และระบบโหลดเสร็จ
local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
local playerGui = localPlayer:WaitForChild("PlayerGui", 30)

local timeout = CONFIG.LOAD_TIMEOUT
local startTime = tick()
while tick() - startTime < timeout do
    local success = pcall(function()
        return require(ReplicatedStorage:WaitForChild("ClientModules"):WaitForChild("PlayerStateClient"))
    end)
    if success then break end
    task.wait(1)
end

task.wait(2)
Log("✅ เกมโหลดเสร็จแล้ว! เริ่มต้นระบบเชื่อมต่อเว็บ!")

Log("🌐 เริ่มต้นเชื่อมต่อระบบเว็บด้วย Key: " .. table.concat(KEYS, ", "))

-- โหลด Networking Module
local Networking
local success, err = pcall(function()
    Networking = require(ReplicatedStorage:WaitForChild("SharedModules"):WaitForChild("Networking"))
end)

if not success then
    warn("ไม่พบ Networking Module: " .. tostring(err))
    return
end

local Mailbox = Networking.Mailbox

-- ====================================================
-- ฟังก์ชันหลัก
-- ====================================================

function GetMyInventory()
    local items = {}
    local success, PlayerStateClient = pcall(function()
        return require(ReplicatedStorage:WaitForChild("ClientModules"):WaitForChild("PlayerStateClient"))
    end)
    
    if success and PlayerStateClient then
        local LocalReplica = PlayerStateClient:GetLocalReplica()
        if LocalReplica and LocalReplica.Data and LocalReplica.Data.Inventory then
            local Inventory = LocalReplica.Data.Inventory
            local categories = {
                Trowels = "Trowels", Seeds = "Seeds", Sprinklers = "Sprinklers",
                WateringCans = "WateringCans", Mushrooms = "Mushrooms", Gnomes = "Gnomes",
                Raccoons = "Raccoons", Crates = "Crates", SeedPacks = "SeedPacks", Props = "Props"
            }
            for category, catName in pairs(categories) do
                if Inventory[category] then
                    for name, count in pairs(Inventory[category]) do
                        if count > 0 then
                            table.insert(items, { Category = catName, ItemKey = name, Count = count, DisplayName = name })
                        end
                    end
                end
            end
            if Inventory.Pets then
                for id, data in pairs(Inventory.Pets) do
                    if data and not data.Equipped then
                        table.insert(items, { Category = "Pets", ItemKey = id, Count = 1, DisplayName = data.Name or id })
                    end
                end
            end
        end
    end
    return items
end

function GetItemCount(currentInv, category, itemKey)
    for _, item in ipairs(currentInv) do
        if item.Category == category and (item.ItemKey == itemKey or string.gsub(item.ItemKey, "_", " ") == string.gsub(itemKey, "_", " ")) then
            return item.Count or 0
        end
    end
    return 0
end

function SearchPlayerGlobal(username)
    if not username or username == "" then return nil end
    local success, userId = pcall(function()
        return Players:GetUserIdFromNameAsync(username)
    end)
    if success and userId then
        return { UserId = userId, Name = username }
    end
    return nil
end

function ReportStatus(commandId, isSuccess)
    local statusText = isSuccess and "สำเร็จ" or "ส่งล้มเหลว"
    local primaryKey = KEYS[1] or ""
    
    pcall(function()
        httpRequest({
            Url = WEB_URL .. "/api/report-status",
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode({ 
                id = commandId, 
                status = statusText,
                key = primaryKey 
            })
        })
    end)
end

function ProcessMultiItemQueue(commandId, targetUsername, itemsList, note)
    local playerData = SearchPlayerGlobal(targetUsername)
    if not playerData then
        warn("❌ ไม่พบผู้รับ: " .. targetUsername)
        ReportStatus(commandId, false)
        return
    end

    local currentInv = GetMyInventory()
    local masterBatchData = {}
    local itemsToCheck = {}

    for _, targetItem in ipairs(itemsList) do
        local cat = targetItem.category or targetItem.Category
        local key = targetItem.itemKey or targetItem.ItemKey
        local reqAmount = targetItem.amount or targetItem.Count or 0

        local countBefore = GetItemCount(currentInv, cat, key)
        
        if countBefore <= 0 and string.find(key, "_") then
            local altKey = string.gsub(key, "_", " ")
            countBefore = GetItemCount(currentInv, cat, altKey)
            if countBefore > 0 then
                key = altKey
            end
        end

        if countBefore > 0 then
            local finalAmount = (reqAmount <= 0 or reqAmount > countBefore) and countBefore or reqAmount
            
            table.insert(itemsToCheck, { Category = cat, ItemKey = key, Before = countBefore, Amount = finalAmount })

            local remaining = finalAmount
            while remaining > 0 do
                local sendAmount = math.min(remaining, MAX_PER_ROUND)
                table.insert(masterBatchData, {
                    Category = cat,
                    ItemKey = key,
                    Count = sendAmount
                })
                remaining = remaining - sendAmount
            end
        else
            warn(string.format("⚠️ ข้าม %s:%s เพราะไม่มีไอเทมในตัว", tostring(cat), tostring(key)))
        end
    end

    if #masterBatchData == 0 then
        warn("❌ ไม่มีไอเทมพร้อมส่งเลยสักชิ้น")
        ReportStatus(commandId, false)
        return
    end

    Log(string.format("🚀 กำลังส่งไอเทมทั้งหมด %d รายการ ไปยัง %s", #itemsList, targetUsername))
    local success = pcall(function()
        Mailbox.SendBatch:Fire(playerData.UserId, masterBatchData, note or "")
    end)

    if not success then
        warn("❌ ส่งไม่สำเร็จ (Mailbox Error)")
        ReportStatus(commandId, false)
        return
    end

    task.wait(CONFIG.MAILBOX_DELAY)
    Log("✅ ทำการส่งคำสั่งและรายงานผลสำเร็จเรียบร้อย!")
    ReportStatus(commandId, true)
end

-- ====================================================
-- ฟังก์ชัน Sync Inventory
-- ====================================================
function SyncInventoryWithKeys()
    local inventory = GetMyInventory()
    local username = localPlayer.Name
    
    for _, currentKey in ipairs(KEYS) do
        pcall(function()
            httpRequest({
                Url = WEB_URL .. "/api/sync-inventory",
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({ 
                    username = username, 
                    key = currentKey, 
                    inventory = inventory 
                })
            })
        end)
    end
end

-- ====================================================
-- ฟังก์ชันเช็คคำสั่ง
-- ====================================================
function FetchCommandsWithKeys()
    local username = localPlayer.Name
    
    for _, currentKey in ipairs(KEYS) do
        pcall(function()
            local res = httpRequest({
                Url = WEB_URL .. "/api/fetch-command?username=" .. username .. "&key=" .. currentKey,
                Method = "GET"
            })
            
            if res and res.StatusCode == 200 then
                local data = HttpService:JSONDecode(res.Body)
                if data.hasCommand then
                    local cmd = data.command
                    Log(string.format("📥 ได้รับคำสั่ง ID: %d (Key: %s) | ส่งให้ %s ทั้งหมด %d รายการ", 
                        cmd.id, currentKey, cmd.targetPlayer, #cmd.items))
                    ProcessMultiItemQueue(cmd.id, cmd.targetPlayer, cmd.items, cmd.note)
                end
            end
        end)
    end
end

Log("🌐 เชื่อมต่อระบบเว็บสำเร็จแล้ว!")
Log("🔑 ใช้ Key: " .. table.concat(KEYS, ", "))

-- ====================================================
-- ลูปซิงค์ Inventory
-- ====================================================
task.spawn(function()
    while task.wait(CONFIG.SYNC_INTERVAL) do
        SyncInventoryWithKeys()
    end
end)

-- ====================================================
-- ลูปเช็กคิวคำสั่ง
-- ====================================================
while task.wait(CONFIG.COMMAND_INTERVAL) do
    FetchCommandsWithKeys()
end
