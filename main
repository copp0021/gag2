if keys and type(keys) == "table" and #keys > 0 then
    CONFIG.KEYS = keys
end

-- 📥 รองรับการ Config จากตัวแปร key (แบบ single key)
if key and type(key) == "string" and key ~= "" then
    CONFIG.KEYS = {key}
end

