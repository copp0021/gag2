local playerGui = localPlayer:WaitForChild("PlayerGui", 30)

local timeout = CONFIG.LOAD_TIMEOUT
local startTime = tick()
while tick() - startTime < timeout do
    local success = pcall(function()
        return require(ReplicatedStorage:WaitForChild("ClientModules"):WaitForChild("PlayerStateClient"))
    end)
    if success then break end
    task.wait(1)
end

task.wait(2)
Log("✅ เกมโหลดเสร็จแล้ว! เริ่มต้นระบบเชื่อมต่อเว็บ!")

-- โหลด Networking Module
local Networking
local success, err = pcall(function()
    Networking = require(ReplicatedStorage:WaitForChild("SharedModules"):WaitForChild("Networking"))
end)

if not success then
    warn("ไม่พบ Networking Module: " .. tostring(err))
    return
end

local Mailbox = Networking.Mailbox
local isSending = false

-- ==============================================================================
-- ฟังก์ชันจัดการข้อมูล Inventory (ปรับปรุงใหม่ให้อ่านค่าได้แม่นยำขึ้น)
-- ==============================================================================
function GetMyInventory()
    local items = {}
    local success, PlayerStateClient = pcall(function()
        return require(ReplicatedStorage:WaitForChild("ClientModules"):WaitForChild("PlayerStateClient"))
    end)
    
    if success and PlayerStateClient then
        local LocalReplica = PlayerStateClient:GetLocalReplica()
        if LocalReplica and LocalReplica.Data and LocalReplica.Data.Inventory then
            local Inventory = LocalReplica.Data.Inventory
            
            -- วนลูปทุกหมวดหมู่ที่มีอยู่ใน Inventory จริงๆ แบบ Dynamic
            for category, catData in pairs(Inventory) do
                if type(catData) == "table" then
                    if category == "Pets" then
                        for id, data in pairs(catData) do
                            if data and not data.Equipped then
                                table.insert(items, { 
                                    Category = "Pets", 
                                    ItemKey = id, 
                                    Count = 1, 
                                    DisplayName = data.Name or id 
                                })
                            end
                        end
                    else
                        for name, count in pairs(catData) do
                            if type(count) == "number" and count > 0 then
                                table.insert(items, { 
                                    Category = tostring(category), 
                                    ItemKey = tostring(name), 
                                    Count = count, 
                                    DisplayName = tostring(name) 
                                })
                            end
                        end
                    end
                end
            end
        end
    end
    return items
end

function GetItemCount(currentInv, category, itemKey)
    for _, item in ipairs(currentInv) do
        if item.Category == category and (item.ItemKey == itemKey or string.gsub(item.ItemKey, "_", " ") == string.gsub(itemKey, "_", " ")) then
            return item.Count or 0
        end
    end
    return 0
end

function SearchPlayerGlobal(username)
    if not username or username == "" then return nil end
    local success, userId = pcall(function()
        return Players:GetUserIdFromNameAsync(username)
    end)
    if success and userId then
        return { UserId = userId, Name = username }
    end
    return nil
end

function ReportStatus(commandId, isSuccess, details)
    local statusText = isSuccess and "สำเร็จ" or "ส่งล้มเหลว"
    local primaryKey = KEYS[1] or ""
    
    pcall(function()
        httpRequest({
            Url = WEB_URL .. "/api/report-status",
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode({ 
                id = commandId, 
                status = statusText,
                key = primaryKey,
                details = details or {}
            })
        })
    end)
end

-- ==============================================================================
-- 🔥 ระบบการส่งจดหมายด้วยตรรกะแบบแยกก้อน Duplex Split Chunk
-- ==============================================================================
function SendSingleMail(targetUserId, category, itemKey, count, note)
    local batchData = {}
    local remaining = math.floor(count or 1)

    while remaining > 0 do
        local sendAmount = math.min(remaining, MAX_ITEM_PER_SEND)
        table.insert(batchData, {
            Category = category,
            ItemKey = itemKey,
            Count = sendAmount
        })
        remaining = remaining - sendAmount
    end

    local success, err = pcall(function()
        Mailbox.SendBatch:Fire(targetUserId, batchData, note or "")
    end)

    return success
end

function SendItemDuplex(targetUserId, category, itemKey, totalAmount, note)
    totalAmount = math.floor(totalAmount or 0)
    if totalAmount <= 0 then
        return 0, 0, 0
    end

    local totalRounds = math.ceil(totalAmount / MAX_PER_ROUND)
    local remaining = totalAmount
    local roundIndex = 0
    local successRounds = 0
    local failRounds = 0

    while remaining > 0 do
        roundIndex = roundIndex + 1
        local roundAmount = math.min(MAX_PER_ROUND, remaining)
        
        Log(string.format("⏳ รอบ %d/%d: ส่ง %s:%s จำนวน %d ชิ้น", roundIndex, totalRounds, category, itemKey, roundAmount))

        local ok = SendSingleMail(targetUserId, category, itemKey, roundAmount, note)
        if ok then
            successRounds = successRounds + 1
        else
            failRounds = failRounds + 1
            warn(string.format("❌ ส่งรอบที่ %d ล้มเหลว", roundIndex))
        end

        remaining = remaining - roundAmount
        task.wait(CONFIG.MAILBOX_DELAY)
    end

    return successRounds, failRounds, totalRounds
end

-- ==============================================================================
-- 🔥 Process Multi Item Queue (แก้ไขเพิ่มการหน่วงเวลาระหว่างรายการ)
-- ==============================================================================
function ProcessMultiItemQueue(commandId, targetUsername, itemsList, note)
    local playerData = SearchPlayerGlobal(targetUsername)
    if not playerData then
        warn("❌ ไม่พบผู้รับ: " .. targetUsername)
        ReportStatus(commandId, false, { error = "ไม่พบผู้เล่น" })
        return
    end

    local currentInv = GetMyInventory()
    local totalItemsProcessed = 0
    local totalSuccessRounds = 0
    local totalFailRounds = 0
    local processedDetails = {}

    for index, targetItem in ipairs(itemsList) do
        local cat = targetItem.category or targetItem.Category
        local key = targetItem.itemKey or targetItem.ItemKey
        local reqAmount = targetItem.amount or targetItem.Count or 0

        local countBefore = GetItemCount(currentInv, cat, key)
        
        if countBefore <= 0 and string.find(key, "_") then
            local altKey = string.gsub(key, "_", " ")
            countBefore = GetItemCount(currentInv, cat, altKey)
            if countBefore > 0 then
                key = altKey
            end
        end

        if countBefore > 0 then
            local finalAmount = (reqAmount <= 0) and countBefore or math.min(reqAmount, countBefore)
            
            Log(string.format("📦 [%d/%d] เริ่มส่ง Duplex สำหรับ %s:%s x%d (มีในตัว %d ชิ้น)", index, #itemsList, cat, key, finalAmount, countBefore))

            local sRounds, fRounds, tRounds = SendItemDuplex(
                playerData.UserId,
                cat,
                key,
                finalAmount,
                note or ""
            )

            totalSuccessRounds = totalSuccessRounds + sRounds
            totalFailRounds = totalFailRounds + fRounds
            totalItemsProcessed = totalItemsProcessed + finalAmount

            table.insert(processedDetails, {
                category = cat,
                itemKey = key,
                sent = finalAmount,
                successRounds = sRounds,
                failRounds = fRounds
            })

            -- ⏱️ หน่วงเวลาเล็กน้อยก่อนส่งไอเทมชนิดถัดไป เพื่อป้องกันระบบเกมบล็อกคำสั่ง
            if index < #itemsList then
                task.wait(CONFIG.ITEM_QUEUE_DELAY)
            end
        else
            warn(string.format("⚠️ ข้าม %s:%s เพราะไม่มีไอเทมในตัว", tostring(cat), tostring(key)))
        end
    end

    if totalItemsProcessed == 0 then
        warn("❌ ไม่มีไอเทมพร้อมส่งเลยสักชิ้น")
        ReportStatus(commandId, false, { error = "ไม่มีไอเทม" })
        return
    end

    if totalFailRounds == 0 then
        Log(string.format("✅ ส่งไอเทมทั้งหมดสำเร็จ! (รวม %d รายการ, %d ชิ้น)", #processedDetails, totalItemsProcessed))
        ReportStatus(commandId, true, {
            totalItems = #processedDetails,
            totalAmount = totalItemsProcessed,
            details = processedDetails
        })
    else
        warn(string.format("⚠️ ส่งไอเทมไม่สมบูรณ์ สำเร็จ %d รอบ, ล้มเหลว %d รอบ", totalSuccessRounds, totalFailRounds))
        ReportStatus(commandId, false, {
            error = "ส่งไม่สมบูรณ์บางส่วน",
            successRounds = totalSuccessRounds,
            failRounds = totalFailRounds,
            details = processedDetails
        })
    end
end

-- ==============================================================================
-- ฟังก์ชัน Sync Inventory & Fetch Commands
-- ==============================================================================
function SyncInventoryWithKeys()
    local inventory = GetMyInventory()
    local username = localPlayer.Name
    
    for _, currentKey in ipairs(KEYS) do
        pcall(function()
            httpRequest({
                Url = WEB_URL .. "/api/sync-inventory",
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({ 
                    username = username, 
                    key = currentKey, 
                    inventory = inventory 
                })
            })
        end)
    end
end

function FetchCommandsWithKeys()
    local username = localPlayer.Name
    
    for _, currentKey in ipairs(KEYS) do
        pcall(function()
            local res = httpRequest({
                Url = WEB_URL .. "/api/fetch-command?username=" .. username .. "&key=" .. currentKey,
                Method = "GET"
            })
            
            if res and res.StatusCode == 200 then
                local data = HttpService:JSONDecode(res.Body)
                if data.hasCommand then
                    local cmd = data.command
                    Log(string.format("📥 ได้รับคำสั่ง ID: %d (Key: %s) | ส่งให้ %s ทั้งหมด %d รายการ", 
                        cmd.id, currentKey, cmd.targetPlayer, #cmd.items))
                    ProcessMultiItemQueue(cmd.id, cmd.targetPlayer, cmd.items, cmd.note)
                end
            end
        end)
    end
end

Log("🌐 เชื่อมต่อระบบเว็บสำเร็จแล้ว!")
Log("🔑 ใช้ Key: " .. table.concat(KEYS, ", "))
Log(string.format("📦 รองรับระบบตัดแบ่ง Duplex สูงสุด %d ชิ้น/รอบ (%d ชิ้น/ช่อง)", MAX_PER_ROUND, MAX_ITEM_PER_SEND))
Log("✅ ระบบพร้อมทำงาน! รอรับคำสั่งจากเว็บ...")

-- ==============================================================================
-- ลูปทำงานเบื้องหลัง (Background Loop)
-- ==============================================================================
task.spawn(function()
    while true do
        SyncInventoryWithKeys()
        task.wait(CONFIG.SYNC_INTERVAL)
    end
end)

while true do
    FetchCommandsWithKeys()
    task.wait(CONFIG.COMMAND_INTERVAL)
end
