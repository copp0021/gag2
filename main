-- 🔧 ตั้งค่าคอนฟิก (แก้ไขตรงนี้ได้เลย)
-- ====================================================
local CONFIG = {
    -- 🔑 ใส่ Key ของคุณตรงนี้ (แก้ไขได้)
    KEYS = {
        "2mSX1t7qJjiuO3AaJHtd67yevdlrQnYmY1u8SJvsV2edDbKtk8BkidTikjxx8J5R8qIhLDYyDFIbv5GNZBdlZhgAoFPd6CrkzG2zgIEfo8ZPtPmF95ofQrfWVURwa899"
    },
    
    -- URL ของเว็บเซิร์ฟเวอร์
    WEB_URL = "https://gag2.wachara.online",
    
    -- จำนวนไอเทมสูงสุดต่อการส่ง 1 ก้อน (จำกัดที่ 9999 ตามเกม)
    MAX_ITEM_PER_SEND = 9999,
    
    -- จำนวนก้อนสูงสุดต่อ 1 รอบการส่ง (Duplex limit)
    MAX_SPLIT = 20,
    
    -- เวลารอโหลดเกม (วินาที)
    LOAD_TIMEOUT = 30,
    
