-- ====================================================
local CONFIG = {
    -- คีย์หลักสำหรับเชื่อมต่อ (สามารถเป็น string เดียว หรือ table ของหลายคีย์)
    KEYS = {"o9h1"},
    
    -- URL ของเว็บเซิร์ฟเวอร์
    WEB_URL = "https://gag2.wachara.online",
    
    -- จำนวนไอเทมสูงสุดต่อการส่ง 1 ครั้ง
    MAX_ITEM_PER_SEND = 9999,
    
    -- จำนวนรอบสูงสุดในการ Split
    MAX_SPLIT = 20,
    
    -- เวลารอโหลดเกม (วินาที)
    LOAD_TIMEOUT = 30,
    
    -- ระยะเวลารอหลังส่ง Mailbox (วินาที)
    MAILBOX_DELAY = 8,
    
    -- ระยะเวลาการ Sync Inventory (วินาที)
    SYNC_INTERVAL = 3,
    
    -- ระยะเวลาการเช็คคำสั่ง (วินาที)
    COMMAND_INTERVAL = 2,
    
    -- เปิด/ปิด Debug Mode
    DEBUG = true,
    
    -- ระยะเวลารอตอบกลับจากเซิร์ฟเวอร์ (วินาที)
    REQUEST_TIMEOUT = 10,
}

